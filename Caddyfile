{
	order rate_limit before reverse_proxy
}

ttb-poc.lawlor.io {
	# Rate-limit only the expensive endpoints (OCR/PDF extraction — real
	# CPU cost per request, and the whole reason this app defaults to
	# local OCR instead of a metered cloud API is that a public,
	# unauthenticated URL is an open-ended abuse surface). Scoped to
	# POST /api/* specifically so it does NOT catch
	# GET /api/verify/batch/{id}, which htmx polls every 2s while a batch
	# runs — that must stay unaffected or the batch progress UI breaks.
	rate_limit {
		zone api_heavy {
			match {
				method POST
				path    /api/*
			}
			key    {remote_host}
			events 10
			window 1m
		}
	}

	reverse_proxy app:8080
}
