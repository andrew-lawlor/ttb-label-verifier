# Optional: "ocr" (default) uses local Tesseract OCR, no API key or network
# call needed. "claude" uses the Claude vision API instead — more robust on
# poor-quality photos, but costs money per call and requires an API key.
# See README "Extraction backend" for the trade-off.
EXTRACTION_BACKEND=ocr

# Only required if EXTRACTION_BACKEND=claude.
ANTHROPIC_API_KEY=

# Optional: defaults to 8080.
PORT=8080
